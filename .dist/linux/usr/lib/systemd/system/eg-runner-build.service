[Unit]
Description=eg runner container
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ProtectKernelModules=yes
PrivateMounts=yes
IPAddressDeny=link-local
IPAddressDeny=multicast
Restart=on-failure
CacheDirectory=%p
ConfigurationDirectory=%p
RuntimeDirectory=%p
RuntimeDirectoryMode=0700
Environment=EG_RUNNER_OVERRIDE_DIR=rootfs
EnvironmentFile=-/etc/eg/runner.env
ExecStartPre=/usr/bin/podman network create --ignore --ipv6 egnet
# egnet-lan puts the runner on the local network with an address from its DHCP server (macvlan) instead of the private
# bridge above, select it with EG_RUNNER_NETWORK=egnet-lan in /etc/eg/runner.env. it is only defined here, nothing uses it
# until selected, and failing to define it doesn't stop the build.
# - the parent interface is EG_RUNNER_DEFAULT_NETWORK_INTERFACE, `eg actl bootstrap env runner` writes it to runner.env.
#   without it the network is created without a parent and the runner can't get an address from it.
# - the network is removed first so it is created again with the current interface, it stays when a runner is using it.
# - requires `systemctl enable --now netavark-dhcp-proxy.socket` on the host.
# - macvlan doesn't work on wifi interfaces, many cloud networks or switches that limit the MACs per port, and the
#   host can't reach the container.
ExecStartPre=/usr/bin/podman network create --ignore -d macvlan --ipam-driver dhcp --ipv6 -o parent=${EG_RUNNER_DEFAULT_NETWORK_INTERFACE} egnet-lan
ExecStart=/usr/bin/podman build --build-arg EG_RUNNER_OVERRIDE_DIR="${EG_RUNNER_OVERRIDE_DIR}" -t eg.runner -f /usr/share/eg/Containerfile /usr/share/eg
# clear out the workload cache after a successful rebuild. renaming is instant, the old caches are removed in the
# background by systemd-tmpfiles --remove (see tmpfiles.d/eg-runner.conf) instead of blocking the build on rm -rf.
# - the leading - covers the first build, when wcache doesn't exist yet.
# - INVOCATION_ID is unique per run of this unit, avoiding collisions (mv into an existing directory would nest wcache).
# - anything left over is also removed at boot by systemd-tmpfiles-setup.
ExecStartPost=-/usr/bin/mv /var/cache/eg-runner/wcache /var/cache/eg-runner/wcache.${INVOCATION_ID}.old
ExecStartPost=-/usr/bin/mv /var/cache/eg-runner-gpu/wcache /var/cache/eg-runner-gpu/wcache.${INVOCATION_ID}.old
ExecStartPost=-/usr/bin/systemd-run --no-block systemd-tmpfiles --remove /usr/lib/tmpfiles.d/eg-runner.conf

[Install]
WantedBy=default.target
