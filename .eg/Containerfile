FROM ubuntu:resolute
ARG DEBIAN_FRONTEND=noninteractive

ARG GOBIN=/usr/bin
ARG GOMODCACHE=/tmp/gomod
ARG GOCACHE=/tmp/gocache

RUN echo "cache buster 4e939dbe-4ee8-4d84-b305-5e94f3dcf1f6"

RUN apt-get update && apt-get -y install software-properties-common build-essential apt-file ca-certificates curl apt-transport-https sudo netavark python3 python3-venv cmake ninja-build libssl-dev
RUN add-apt-repository -n ppa:longsleep/golang-backports
RUN add-apt-repository -n ppa:egdaemon/eg
RUN apt-get update && apt-get -y install dput devscripts dh-make dput git uidmap dbus-user-session fuse-overlayfs tree iproute2
RUN apt-get update && apt-get -y install golang-1.27 podman rsync vim egworkload dpkg tree pinentry-tty protobuf-compiler libprotobuf-dev libbtrfs-dev libassuan-dev libc6-dev libdevmapper-dev libglib2.0-dev libgpgme-dev libgpg-error-dev libprotobuf-c-dev libseccomp-dev libselinux1-dev libsystemd-dev pciutils llama.cpp

RUN ln -s /usr/lib/go-1.27/bin/go /usr/local/bin/go

RUN podman --version
RUN go install github.com/pressly/goose/v3/cmd/goose@latest
RUN go install github.com/fatih/gomodifytags@latest
RUN go install golang.org/x/tools/cmd/goimports@latest
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.28.1
RUN go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest
RUN go install github.com/onsi/ginkgo/v2/...@latest
RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.0.2
RUN sh /usr/share/eg/install/genieql.sh
RUN which genieql
RUN which goose
RUN which goimports
RUN which protoc
RUN which protoc-gen-go-grpc
RUN which protoc-gen-go

RUN systemd-tmpfiles --create
RUN systemd-tmpfiles --clean

CMD /usr/sbin/init
