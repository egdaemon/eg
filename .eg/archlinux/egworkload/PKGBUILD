# Maintainer: engineering <engineering@egdaemon.com>
pkgname=egworkload
pkgver=${PKGVER}
pkgrel=1
pkgdesc='configures a system for running eg workloads'
url='https://github.com/egdaemon/eg'
arch=('any')
license=('AGPL')
install=egworkload.install
depends=(
  'egd'
  'sudo'
  'git'
  'go'
  'systemd'   # machinectl, sysusers, tmpfiles.
  'waypipe'   # required to support --wayland passthrough.
  'openssh'   # allows ssh access into workload containers, i.e. eg compute serve --ssh.
)

# EG_SOURCE_URL lets the ci workload build the commit being released instead of whatever is on github.
# the payload is shared with the debian egworkload package, see .dist/egworkload.
source=("egd::${EG_SOURCE_URL:-git+https://github.com/egdaemon/eg.git}"
        "egworkload.install")
sha1sums=('SKIP' 'SKIP')

package() {
  cp -r ${srcdir}/egd/.dist/egworkload/* ${pkgdir}
}
