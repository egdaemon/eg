FROM ubuntu:resolute
ARG DEBIAN_FRONTEND=noninteractive

RUN echo "cache buster 61571c95-0539-4f6e-bad4-f913db80e224"
RUN apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 update
RUN apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 install -y software-properties-common build-essential ca-certificates curl sudo podman netavark rsync vim dput devscripts dh-make dput git uidmap dbus-user-session tree python3 python3-venv cmake ninja-build libssl-dev
RUN add-apt-repository -n ppa:longsleep/golang-backports
RUN add-apt-repository -n ppa:egdaemon/eg

RUN echo "cache buster 61571c95-0539-4f6e-bad4-f913db80e225"
RUN apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 update && apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 -y install golang-1.27 libbtrfs-dev libassuan-dev libc6-dev libdevmapper-dev libglib2.0-dev libgpgme-dev libgpg-error-dev libprotobuf-dev libprotobuf-c-dev libseccomp-dev libselinux1-dev libsystemd-dev

RUN ln -s /usr/lib/go-1.27/bin/go /usr/local/bin/go

RUN echo "cache buster 61571c95-0539-4f6e-bad4-f913db80e227"
RUN apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 update && apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=8 -o Acquire::https::Timeout=8 -y install egworkload gh
# resolute ships libgcrypt 1.12.0 which has upstream bug T8080 (gpg-agent rejects valid ECDH keys on import with
# "Bad secret key"), fixed in >= 1.12.1. manually install libgcrypt20 1.12.2 from stonking until resolute backports it.
RUN arch="$(dpkg --print-architecture)"; \
    if [ "${arch}" = "amd64" ]; then mirror="http://archive.ubuntu.com/ubuntu"; else mirror="http://ports.ubuntu.com/ubuntu-ports"; fi; \
    curl -fsSL -o /tmp/libgcrypt20.deb "${mirror}/pool/main/libg/libgcrypt20/libgcrypt20_1.12.2-1ubuntu2_${arch}.deb"; \
    dpkg -i /tmp/libgcrypt20.deb; \
    rm -f /tmp/libgcrypt20.deb

# temporary hack until new release is out
RUN systemctl mask tmp.mount dev-mqueue.mount systemd-ask-password-console.path systemd-ask-password-wall.path systemd-resolved.service systemd-resolved-monitor.socket systemd-resolved-varlink.socket