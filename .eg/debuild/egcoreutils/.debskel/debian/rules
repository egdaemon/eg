#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
DH_VERBOSE=1

%:
	dh $@

override_dh_auto_build:
	echo "DH AUTO BUILD OVERRIDE pkg version '${DEB_VERSION}'"
	install -D -m 0644 src/coreutils.wasm linux/usr/share/eg/coreutils.wasm

override_dh_usrlocal:
	echo "DH usrlocal override due to overly restrict rules"
