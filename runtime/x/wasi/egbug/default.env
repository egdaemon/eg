CI=true
DEBIAN_FRONTEND=noninteractive
EG_COMPUTE_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
EG_COMPUTE_CACHE_DIRECTORY=/workload/.eg.cache
EG_COMPUTE_GPU=false
EG_COMPUTE_GUEST_MIGRATIONS_ENABLED=true
EG_COMPUTE_HOST_ARCH=amd64
EG_COMPUTE_HOST_OS=linux
EG_COMPUTE_INITIATED_TIMESTAMP=0000-00-00T00:00:00-00:00
EG_COMPUTE_LOG_VERBOSITY=0
EG_COMPUTE_MODULE_LEVEL=0
EG_COMPUTE_PROFILE_MODE=
EG_COMPUTE_RUNTIME_DIRECTORY=/eg.mnt/.eg.runtime
EG_COMPUTE_RUN_ID=00000000-0000-0000-0000-000000000000
EG_COMPUTE_TTL=0s
EG_COMPUTE_VCS_URI=git@github.com:egdaemon/eg.git
EG_COMPUTE_WORKING_DIRECTORY=/workload/eg
EG_COMPUTE_WORKLOAD=
EG_COMPUTE_WORKLOAD_DIRECTORY=/workload
EG_COMPUTE_WORKSPACE_DIRECTORY=/workload/.eg.workspace
EG_GIT_BASE_COMMIT=0000000000000000000000000000000000000000
EG_GIT_BASE_REF=main
EG_GIT_BASE_URI=/workload/eg
EG_GIT_BASE_VCS=git@github.com:egdaemon/eg.git
EG_GIT_HEAD_COMMIT=0000000000000000000000000000000000000000
EG_GIT_HEAD_COMMIT_AUTHOR=Egdaemon
EG_GIT_HEAD_COMMIT_EMAIL=noreply@egdaemon.com
EG_GIT_HEAD_COMMIT_TIMESTAMP=0000-00-00T00:00:00-00:00
EG_GIT_HEAD_REF=HEAD
EG_GIT_HEAD_URI=/workload/eg
EG_GIT_HEAD_VCS=git@github.com:egdaemon/eg.git
EG_UNSAFE_CACHE_ID=00000000-0000-0000-0000-000000000000
EG_UNSAFE_GIT_CLONE_ENABLED=false
HOME=/root
LANG=en_US.UTF-8
PAGER=cat
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
PWD=/workload/eg
SSL_CERT_DIR=/etc/ssl/certs
TERM=unknown
container=podman
