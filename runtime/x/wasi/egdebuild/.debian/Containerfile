FROM ubuntu:resolute
ARG DEBIAN_FRONTEND=noninteractive

RUN echo "cache buster e735a82d-4291-40cf-be3e-3a44caf7d8b4"
RUN apt-get update
RUN apt-get install -y software-properties-common build-essential ca-certificates curl sudo podman netavark rsync vim dput devscripts dh-make dput git uidmap dbus-user-session tree python3 python3-venv
RUN add-apt-repository -n ppa:longsleep/golang-backports
RUN add-apt-repository -n ppa:egdaemon/eg

RUN echo "cache buster 829262f0-be2b-4e1e-8cff-336acc51573b"
RUN apt-get update
RUN apt-get -y install golang-1.27 egworkload

RUN ln -s /usr/lib/go-1.27/bin/go /usr/local/bin/go

# resolute ships libgcrypt 1.12.0 which has upstream bug T8080 (gpg-agent rejects valid ECDH keys on import with
# "Bad secret key"), fixed in >= 1.12.1. manually install libgcrypt20 1.12.2 from stonking until resolute backports it.
RUN arch="$(dpkg --print-architecture)"; \
    if [ "${arch}" = "amd64" ]; then mirror="http://archive.ubuntu.com/ubuntu"; else mirror="http://ports.ubuntu.com/ubuntu-ports"; fi; \
    curl -fsSL -o /tmp/libgcrypt20.deb "${mirror}/pool/main/libg/libgcrypt20/libgcrypt20_1.12.2-1ubuntu2_${arch}.deb"; \
    dpkg -i /tmp/libgcrypt20.deb

RUN systemd-tmpfiles --create
RUN systemd-tmpfiles --clean
RUN rm -rf /tmp/gomod /tmp/gocache /tmp/*.deb
RUN du -xsh /tmp/*
