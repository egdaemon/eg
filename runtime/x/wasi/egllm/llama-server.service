[Unit]
Description=llama.cpp server
After=network.target

[Service]
EnvironmentFile=/etc/default/llama-server
# the socket must match egllm.DefaultEndpoint. it is group writable so the egd user can connect.
RuntimeDirectory=llama-server
Group=egd
UMask=0007
ExecStart=/usr/bin/llama-server -hf ${LLAMA_MODEL} --host /run/llama-server/llama.sock --cache-prompt --cache-reuse 256 -ctk q8_0 -ctv q8_0 -fa on
Restart=on-failure

[Install]
WantedBy=multi-user.target
